{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=LineageStudioDB;Username=postgres;Password=1234"
  },
  "JwtSettings": {
    "SecretKey": "LineageStudio@SuperSecret#Key$2026!MustBe32CharsOrMore",
    "Issuer": "LineageStudioAPI",
    "Audience": "LineageStudioClient",
    "AccessTokenMinutes": 480
  }
}
