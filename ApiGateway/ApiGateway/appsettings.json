{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "restaurant-route": {
        "ClusterId": "restaurant-cluster",
        "Match": {
          "Path": "/api/restaurant/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "auth-route": {
        "ClusterId": "superadmin-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "org-settings-route": {
        "ClusterId": "restaurant-cluster",
        "Order": -10,
        "Match": {
          "Path": "/api/organizations/{orgId}/settings"
        }
      },
      "org-reports-route": {
        "ClusterId": "restaurant-cluster",
        "Order": -10,
        "Match": {
          "Path": "/api/organizations/{orgId}/reports"
        }
      },
      "org-users-route": {
        "ClusterId": "restaurant-cluster",
        "Order": -10,
        "Match": {
          "Path": "/api/organizations/{orgId}/users"
        }
      },
      "org-user-detail-route": {
        "ClusterId": "restaurant-cluster",
        "Order": -10,
        "Match": {
          "Path": "/api/organizations/{orgId}/users/{userId}"
        }
      },
      "org-admins-route": {
        "ClusterId": "restaurant-cluster",
        "Order": -10,
        "Match": {
          "Path": "/api/organizations/{orgId}/admins"
        }
      },
      "organizations-route": {
        "ClusterId": "superadmin-cluster",
        "Match": {
          "Path": "/api/organizations/{**catch-all}"
