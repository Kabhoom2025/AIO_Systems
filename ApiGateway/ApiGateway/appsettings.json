          "Path": "/hubs/lineagestudio/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/hubs/{**catch-all}" }
        ]
      },
      "restaurant-catchall-route": {
        "ClusterId": "restaurant-cluster",
        "Order": 100,
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "hubs-route": {
        "ClusterId": "restaurant-cluster",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      }
    },
