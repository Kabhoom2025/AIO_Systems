        "Match": {
          "Path": "/api/platform-modules/{**catch-all}"
        }
      },
      "registered-services-route": {
        "ClusterId": "superadmin-cluster",
        "Match": {
          "Path": "/api/registered-services/{**catch-all}"
        }
      },
      "pharmacy-route": {
        "ClusterId": "pharmacy-cluster",
        "Match": {
          "Path": "/api/pharmacy/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      },
      "hrms-route": {
        "ClusterId": "hrms-cluster",
        "Match": {
          "Path": "/api/hrms/{**catch-all}"
