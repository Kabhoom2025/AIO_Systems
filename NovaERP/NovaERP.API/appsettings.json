{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=NovaERPDB;Username=postgres;Password=1234",
    "SqlServerConnection": "Server=localhost;Database=NovaERPDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "DatabaseProvider": "PostgreSql",
  "FileStorage": {
    "RootPath": "App_Data/documents",
    "MaxSizeBytes": 20971520
  },
  "JwtSettings": {
    "SecretKey": "FoodOrder@SuperSecret#Key$2025!MustBe32CharsOrMore",
    "Issuer": "FoodOrderAPI",
    "Audience": "FoodOrderClient",
    "AccessTokenMinutes": 480,
    "RefreshTokenDays": 7
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
